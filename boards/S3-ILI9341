[env:S3-ILI9341]
platform = espressif32
board = esp32-s3-devkitc-1
framework = arduino
monitor_speed = 115200
upload_speed = 921600
lib_ldf_mode = deep+

build_flags =
    -DCORE_DEBUG_LEVEL=0
    -DUSER_SETUP_LOADED=1
    
    ; --- Sterownik ekranu ---
    -DILI9341_DRIVER=1
    -DTFT_WIDTH=240
    -DTFT_HEIGHT=320
    ;-DTFT_INVERSION_ON=1
    
    ; --- Twoje piny SPI (Ekran) ---
    -DTFT_MOSI=11
    -DTFT_SCLK=12
    -DTFT_MISO=13
    -DTFT_CS=10
    -DTFT_DC=7
    -DTFT_RST=6
    -DTFT_BL=5

    ; --- Piny dotyku i SD ---
    -DTOUCH_CS=14
    -DSD_CS=21

    ; --- USB / Serial ---
    -DARDUINO_USB_CDC_ON_BOOT=1
    -DARDUINO_USB_MODE=1

board_build.partitions = default_16MB.csv
